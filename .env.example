# Firebase Web SDK Configuration (FormaCV — Auth & Cloud Firestore)
# Dapatkan nilai ini dari Firebase Console -> Project Settings -> Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opsional: Path custom binary pdflatex untuk engine PDF Overleaf (/api/pdf/latex)
# Kosongkan untuk deteksi otomatis (PATH, /Library/TeX/texbin/pdflatex, Docker TeX Live)
# PDFLATEX_BIN=pdflatex
